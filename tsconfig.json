{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["backend/shared/*"]
    }
  },
  "include": [
    "backend/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "app/frontend"
  ]
}
