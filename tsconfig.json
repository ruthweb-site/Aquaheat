{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./backend/shared/*"]
    }
  },
  "include": [
    "backend/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "app/frontend",
    "backend/functions/alerts",
    "backend/functions/emergency",
    "backend/functions/health",
    "backend/functions/heat-risk",
    "backend/functions/recommendations",
    "backend/functions/weather",
    "backend/functions/weather-ingestion"
  ]
}
